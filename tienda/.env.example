# =====================================================================
#  Tienda en línea — variables de entorno
#  Copie este archivo como .env (en esta misma carpeta tienda/) y complete
#  los valores. El archivo .env NO se sube a git (está en .gitignore).
# =====================================================================

# Clave para firmar cookies de sesión: una cadena aleatoria y larga.
# Puede generarla con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Conexión a MySQL 8.x (base creada con database/schema.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drogueria_db
# Usuario de la aplicación; se recomienda uno con solo permiso SELECT sobre drogueria_db (ver README.md)
DB_USER=
DB_PASSWORD=

# Servidor de desarrollo
APP_HOST=127.0.0.1
APP_PORT=5050
FLASK_DEBUG=0
