# ====================================================================
#  DrogueriaGestión - Variables de entorno
#  Copie este archivo como .env y ajuste los valores.
# ====================================================================

# Clave para firmar las cookies de sesión (genere una aleatoria y larga)
SECRET_KEY=cambie-esta-clave-por-una-aleatoria

# Servidor MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drogueria_gestion
# Base de pedidos de la tienda en línea (el usuario DB_USER requiere SELECT)
TIENDA_DB_NAME=drogueria_db
# Base de datos que usan las pruebas automáticas (pytest); debe ser distinta de DB_NAME
DB_NAME_TEST=drogueria_gestion_test

# Usuario que usa la aplicación (lo crea database/init_db.py con privilegios mínimos)
DB_USER=drogueria_app
DB_PASSWORD=Cambie-Esta-Clave-2026

# Usuario administrador de MySQL, solo para instalar la base de datos.
# Si DB_ADMIN_PASSWORD se deja vacío, init_db.py la pedirá por consola.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Servidor web
APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=0
MINUTOS_INACTIVIDAD=60
